#!/bin/bash
# Forensic OS - live-build auto/clean
# Wrapper around lb clean with safety and logging
set -euo pipefail

readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[1;33m'
readonly NC='\033[0m'

log_info()  { echo -e "${GREEN}[CLEAN]${NC} $*"; }
log_warn()  { echo -e "${YELLOW}[WARN]${NC} $*"; }
log_error() { echo -e "${RED}[ERROR]${NC} $*" >&2; }

log_info "Cleaning Forensic OS build environment..."

lb clean noauto "${@}"

# Remove leftover build artifacts
rm -f build.log
rm -f *.iso *.zsync *.contents *.files *.packages

log_info "Clean complete."
