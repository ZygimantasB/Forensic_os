#!/bin/bash
# Forensic OS - live-build auto/build
# Wrapper around lb build with logging and error handling
set -euo pipefail

readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[1;33m'
readonly NC='\033[0m'

BUILD_LOG="build.log"
START_TIME=$(date +%s)

log_info()  { echo -e "${GREEN}[BUILD]${NC} $*"; }
log_warn()  { echo -e "${YELLOW}[WARN]${NC} $*"; }
log_error() { echo -e "${RED}[ERROR]${NC} $*" >&2; }

log_info "Starting Forensic OS build at $(date)"
log_info "Build log: ${BUILD_LOG}"

lb build noauto "${@}" 2>&1 | tee "${BUILD_LOG}"
BUILD_EXIT=${PIPESTATUS[0]}

END_TIME=$(date +%s)
ELAPSED=$(( END_TIME - START_TIME ))
MINUTES=$(( ELAPSED / 60 ))
SECONDS_REM=$(( ELAPSED % 60 ))

if [ "${BUILD_EXIT}" -eq 0 ]; then
    log_info "Build completed successfully in ${MINUTES}m ${SECONDS_REM}s"
    ISO_FILE=$(find . -maxdepth 1 -name "*.iso" -type f -printf '%T@ %p\n' 2>/dev/null | sort -rn | head -1 | awk '{print $2}')
    if [ -n "${ISO_FILE}" ]; then
        ISO_SIZE=$(du -h "${ISO_FILE}" | cut -f1)
        log_info "ISO image: ${ISO_FILE} (${ISO_SIZE})"
        log_info "SHA256: $(sha256sum "${ISO_FILE}" | awk '{print $1}')"
    fi
else
    log_error "Build FAILED after ${MINUTES}m ${SECONDS_REM}s (exit code: ${BUILD_EXIT})"
    log_error "Check ${BUILD_LOG} for details"
    exit "${BUILD_EXIT}"
fi
