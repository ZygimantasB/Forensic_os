# Forensic OS - Forensic Tools Package List
# Only packages available in Ubuntu 24.04 (Noble) repos

# Disk / filesystem forensics
sleuthkit
foremost
scalpel
dcfldd
testdisk

# Disk image handling
ewf-tools
xmount

# Hashing and verification
hashdeep

# Binary / firmware analysis
binwalk
xxd
hexedit

# Network forensics
tshark
tcpdump
ngrep

# Malware analysis / pattern matching
yara
clamav
clamav-daemon

# Metadata extraction
libimage-exiftool-perl

# Volume and encryption
cryptsetup
lvm2
ntfs-3g
dislocker

# Archive tools
p7zip-full

# Data recovery
extundelete
recoverjpeg

# Misc forensic utilities
pv
dc3dd
