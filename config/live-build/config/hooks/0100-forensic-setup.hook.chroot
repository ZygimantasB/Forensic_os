#!/bin/bash
# Forensic OS - Chroot Hook: Forensic Environment Setup
# Runs inside the chroot during live-build to configure the forensic workstation
set -euo pipefail

echo "[HOOK] Starting forensic environment setup..."

# =============================================================================
# 1. Disable swap to prevent evidence contamination
# =============================================================================
echo "[HOOK] Disabling swap..."
echo "vm.swappiness=0" >> /etc/sysctl.d/99-forensic.conf

# Remove any swap entries from fstab
sed -i '/swap/d' /etc/fstab 2>/dev/null || true

# =============================================================================
# 2. Disable automount to prevent evidence modification
# =============================================================================
echo "[HOOK] Disabling automount..."
mkdir -p /etc/udisks2
cat > /etc/udisks2/udisks2.conf << 'UDISKS'
[udisks2]
modules=*
modules_load_preference=ondemand

[defaults]
encryption=luks1

[ATA]
# Disable automount
automount=false
UDISKS

# =============================================================================
# 3. Create forensic user
# =============================================================================
echo "[HOOK] Creating forensic user..."
if ! id forensic &>/dev/null; then
    useradd -m -s /bin/bash -G sudo,disk,cdrom,plugdev forensic
    echo "forensic:forensic" | chpasswd
fi

# =============================================================================
# 4. Create symlinks for forensic tools
# =============================================================================
echo "[HOOK] Creating symlinks for forensic tools..."
TOOLS_DIR="/opt/forensic-os/tools"
if [ -d "$TOOLS_DIR" ]; then
    for tool in "$TOOLS_DIR"/forensic-*; do
        [ -f "$tool" ] || continue
        toolname=$(basename "$tool")
        ln -sf "$tool" "/usr/local/bin/$toolname"
        chmod +x "$tool"
    done
fi

# Symlink the launchers
[ -f /opt/forensic-os/ui/forensic-launcher ] && \
    ln -sf /opt/forensic-os/ui/forensic-launcher /usr/local/bin/forensic-launcher
[ -f /opt/forensic-os/ui/forensic-gui ] && \
    ln -sf /opt/forensic-os/ui/forensic-gui /usr/local/bin/forensic-gui

# =============================================================================
# 5. Install the udev write-blocking rules
# =============================================================================
echo "[HOOK] Installing udev write-blocking rules..."
if [ -f /opt/forensic-os/config/99-forensic-writeblock.rules ]; then
    cp /opt/forensic-os/config/99-forensic-writeblock.rules /etc/udev/rules.d/
fi

# =============================================================================
# 6. Configure LightDM autologin
# =============================================================================
echo "[HOOK] Configuring autologin..."
mkdir -p /etc/lightdm/lightdm.conf.d
cat > /etc/lightdm/lightdm.conf.d/50-forensic-autologin.conf << 'LIGHTDM'
[Seat:*]
autologin-user=forensic
autologin-user-timeout=0
LIGHTDM

# =============================================================================
# 7. Set MOTD banner
# =============================================================================
echo "[HOOK] Setting MOTD..."
cat > /etc/motd << 'MOTD'

  ╔══════════════════════════════════════════════════╗
  ║            ForensicOS - Digital Forensics        ║
  ║                                                  ║
  ║  WARNING: All drives are WRITE-BLOCKED by       ║
  ║  default. Use forensic-mount to safely mount     ║
  ║  evidence drives.                                ║
  ║                                                  ║
  ║  Type 'forensic-launcher' to start the           ║
  ║  investigation toolkit.                          ║
  ╚══════════════════════════════════════════════════╝

MOTD

# =============================================================================
# 8. Desktop autostart for forensic launcher
# =============================================================================
echo "[HOOK] Setting up desktop autostart..."
mkdir -p /etc/xdg/autostart
cat > /etc/xdg/autostart/forensic-welcome.desktop << 'DESKTOP'
[Desktop Entry]
Type=Application
Name=ForensicOS Welcome
Exec=/bin/bash -c 'sleep 2 && zenity --info --title="ForensicOS" --text="Welcome to ForensicOS\n\nAll drives are WRITE-BLOCKED.\nUse forensic-launcher or forensic-gui to begin.\n\nType forensic-launcher in terminal for CLI mode." --width=400 2>/dev/null || true'
Hidden=false
NoDisplay=false
X-GNOME-Autostart-enabled=true
DESKTOP

# =============================================================================
# 9. Install pip packages (volatility3)
# =============================================================================
echo "[HOOK] Installing pip forensic tools..."
pip3 install --break-system-packages volatility3 2>/dev/null || \
    echo "[HOOK] WARN: volatility3 pip install failed (non-critical)"

echo "[HOOK] Forensic environment setup complete."
