#!/bin/bash
# Forensic OS - Chroot Hook: Forensic Environment Setup
# Runs inside the chroot during live-build to configure the forensic workstation
set -euo pipefail

echo "[HOOK] Starting forensic environment setup..."

# =============================================================================
# 1. Disable swap to prevent evidence contamination
# =============================================================================
echo "[HOOK] Disabling swap..."
swapoff -a 2>/dev/null || true
# Remove swap entries from fstab
sed -i '/\sswap\s/d' /etc/fstab 2>/dev/null || true
# Prevent swap from being enabled at boot
cat > /etc/sysctl.d/99-forensic-noswap.conf << 'EOF'
vm.swappiness=0
EOF

# Create systemd override to disable zram/swap services
mkdir -p /etc/systemd/system
for svc in swap.target zram-setup@.service; do
    ln -sf /dev/null "/etc/systemd/system/${svc}" 2>/dev/null || true
done

# =============================================================================
# 2. Create forensic user
# =============================================================================
echo "[HOOK] Setting up forensic user..."
if ! id -u forensic &>/dev/null; then
    useradd -m -s /bin/bash -G sudo,disk,cdrom,plugdev forensic
    echo "forensic:forensic" | chpasswd
fi

# Allow forensic user to sudo without password (live environment)
echo "forensic ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/forensic
chmod 0440 /etc/sudoers.d/forensic

# =============================================================================
# 3. Configure LightDM for auto-login
# =============================================================================
echo "[HOOK] Configuring display manager..."
mkdir -p /etc/lightdm/lightdm.conf.d
cat > /etc/lightdm/lightdm.conf.d/50-forensic-autologin.conf << 'EOF'
[Seat:*]
autologin-user=forensic
autologin-user-timeout=0
user-session=xfce
EOF

# =============================================================================
# 4. Configure XFCE desktop for forensic use
# =============================================================================
echo "[HOOK] Configuring XFCE desktop..."
FORENSIC_HOME="/home/forensic"
XFCE_CONFIG="${FORENSIC_HOME}/.config/xfce4"
mkdir -p "${XFCE_CONFIG}/terminal" "${XFCE_CONFIG}/panel" "${XFCE_CONFIG}/xfconf/xfce-perchannel-xml"

# Dark theme and panel config
cat > "${XFCE_CONFIG}/xfconf/xfce-perchannel-xml/xsettings.xml" << 'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<channel name="xsettings" version="1.0">
  <property name="Net" type="empty">
    <property name="ThemeName" type="string" value="Adwaita-dark"/>
    <property name="IconThemeName" type="string" value="Adwaita"/>
  </property>
</channel>
EOF

# Desktop wallpaper message
cat > "${XFCE_CONFIG}/xfconf/xfce-perchannel-xml/xfce4-desktop.xml" << 'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<channel name="xfce4-desktop" version="1.0">
  <property name="backdrop" type="empty">
    <property name="screen0" type="empty">
      <property name="monitorVirtual1" type="empty">
        <property name="workspace0" type="empty">
          <property name="color-style" type="int" value="0"/>
          <property name="rgba1" type="array">
            <value type="double" value="0.1"/>
            <value type="double" value="0.1"/>
            <value type="double" value="0.15"/>
            <value type="double" value="1"/>
          </property>
        </property>
      </property>
    </property>
  </property>
</channel>
EOF

# =============================================================================
# 5. Create forensic desktop launchers
# =============================================================================
echo "[HOOK] Creating desktop launchers..."
DESKTOP_DIR="${FORENSIC_HOME}/Desktop"
mkdir -p "${DESKTOP_DIR}"

cat > "${DESKTOP_DIR}/autopsy.desktop" << 'EOF'
[Desktop Entry]
Type=Application
Name=Autopsy
Comment=Digital Forensics Platform
Exec=autopsy
Icon=autopsy
Terminal=false
Categories=System;Security;
EOF

cat > "${DESKTOP_DIR}/wireshark.desktop" << 'EOF'
[Desktop Entry]
Type=Application
Name=Wireshark
Comment=Network Protocol Analyzer
Exec=wireshark
Icon=wireshark
Terminal=false
Categories=Network;Security;
EOF

cat > "${DESKTOP_DIR}/guymager.desktop" << 'EOF'
[Desktop Entry]
Type=Application
Name=Guymager
Comment=Forensic Disk Imager
Exec=sudo guymager
Icon=guymager
Terminal=false
Categories=System;Security;
EOF

chmod +x "${DESKTOP_DIR}"/*.desktop

# =============================================================================
# 6. Install Python forensic packages via pip
# =============================================================================
echo "[HOOK] Installing Python forensic packages..."
pip3 install --break-system-packages --no-cache-dir \
    volatility3 \
    yara-python \
    dfvfs \
    plaso \
    artifacts \
    dtfabric \
    pycryptodome \
    python-registry \
    iocextract \
    oletools \
    peepdf \
    pdf-parser \
    2>/dev/null || echo "[HOOK] WARNING: Some pip packages failed to install (non-fatal)"

# =============================================================================
# 7. Forensic-safe mount defaults
# =============================================================================
echo "[HOOK] Configuring forensic-safe mount defaults..."
cat > /etc/udev/rules.d/99-forensic-readonly.rules << 'EOF'
# Default block devices to read-only to prevent evidence tampering
# The user must explicitly remount read-write if needed
SUBSYSTEM=="block", ENV{ID_FS_USAGE}=="filesystem", ATTR{ro}="1"
EOF

# udisks2 policy: mount as read-only by default
mkdir -p /etc/udisks2
cat > /etc/udisks2/mount_options.conf << 'EOF'
[defaults]
defaults=ro,noatime,noexec,nosuid,nodev
EOF

# =============================================================================
# 8. Set forensic MOTD
# =============================================================================
echo "[HOOK] Setting MOTD..."
cat > /etc/motd << 'EOF'

  _____ ___  ____  _____ _   _ ____ ___ ____    ___  ____
 |  ___/ _ \|  _ \| ____| \ | / ___|_ _/ ___|  / _ \/ ___|
 | |_ | | | | |_) |  _| |  \| \___ \| | |     | | | \___ \
 |  _|| |_| |  _ <| |___| |\  |___) | | |___  | |_| |___) |
 |_|   \___/|_| \_\_____|_| \_|____/___\____|  \___/|____/

 Forensic Workstation - All drives mounted READ-ONLY by default.
 Use 'sudo mount -o remount,rw /dev/sdX /mnt' to enable write access.

EOF

# =============================================================================
# 9. Fix ownership
# =============================================================================
chown -R forensic:forensic "${FORENSIC_HOME}"

echo "[HOOK] Forensic environment setup complete."
