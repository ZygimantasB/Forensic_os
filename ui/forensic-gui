#!/usr/bin/env bash
#
# forensic-gui - ForensicOS GUI Launcher using YAD/Zenity
#

set -euo pipefail

FORENSIC_ROOT="${FORENSIC_ROOT:-/home/user/Forensic_os}"
TOOLS_DIR="${FORENSIC_ROOT}/tools"
GUI_TITLE="ForensicOS - Digital Forensic Suite"

# Detect GUI toolkit
GUI_CMD=""
if command -v yad &>/dev/null; then
    GUI_CMD="yad"
elif command -v zenity &>/dev/null; then
    GUI_CMD="zenity"
else
    echo "ERROR: Neither yad nor zenity found. Install one of them." >&2
    echo "  sudo apt install yad   OR   sudo apt install zenity" >&2
    exit 1
fi

# ─── Helper functions ────────────────────────────────────────────────────────

show_info() {
    local title="$1"
    local text="$2"
    if [[ "$GUI_CMD" == "yad" ]]; then
        yad --title="$title" --text-info --width=700 --height=500 \
            --button="Close:0" --fontname="Monospace 10" <<< "$text"
    else
        zenity --text-info --title="$title" --width=700 --height=500 \
            --font="Monospace 10" <<< "$text"
    fi
}

show_message() {
    local title="$1"
    local text="$2"
    if [[ "$GUI_CMD" == "yad" ]]; then
        yad --title="$title" --text="$text" --button="OK:0" --width=400
    else
        zenity --info --title="$title" --text="$text" --width=400
    fi
}

show_error() {
    local text="$1"
    if [[ "$GUI_CMD" == "yad" ]]; then
        yad --title="Error" --text="$text" --button="OK:1" --image=dialog-error --width=400
    else
        zenity --error --title="Error" --text="$text" --width=400
    fi
}

file_chooser() {
    local title="$1"
    local filter="${2:-}"
    if [[ "$GUI_CMD" == "yad" ]]; then
        yad --file --title="$title" ${filter:+--file-filter="$filter"} 2>/dev/null
    else
        zenity --file-selection --title="$title" ${filter:+--file-filter="$filter"} 2>/dev/null
    fi
}

dir_chooser() {
    local title="$1"
    if [[ "$GUI_CMD" == "yad" ]]; then
        yad --file --directory --title="$title" 2>/dev/null
    else
        zenity --file-selection --directory --title="$title" 2>/dev/null
    fi
}

save_chooser() {
    local title="$1"
    if [[ "$GUI_CMD" == "yad" ]]; then
        yad --file --save --title="$title" 2>/dev/null
    else
        zenity --file-selection --save --title="$title" 2>/dev/null
    fi
}

progress_pipe() {
    local title="$1"
    if [[ "$GUI_CMD" == "yad" ]]; then
        yad --progress --title="$title" --auto-close --auto-kill --width=400
    else
        zenity --progress --title="$title" --auto-close --auto-kill --width=400
    fi
}

form_dialog() {
    local title="$1"
    shift
    if [[ "$GUI_CMD" == "yad" ]]; then
        yad --form --title="$title" --width=500 "$@" 2>/dev/null
    else
        # zenity doesn't have native form; use --forms
        zenity --forms --title="$title" --width=500 "$@" 2>/dev/null
    fi
}

# ─── Actions ─────────────────────────────────────────────────────────────────

action_new_case() {
    local result
    if [[ "$GUI_CMD" == "yad" ]]; then
        result=$(yad --form --title="New Forensic Case" --width=500 \
            --field="Case Number:" "" \
            --field="Examiner:" "$(whoami)" \
            --field="Description:" "" \
            --button="Create:0" --button="Cancel:1" 2>/dev/null) || return
        local case_num examiner desc
        case_num=$(echo "$result" | cut -d'|' -f1)
        examiner=$(echo "$result" | cut -d'|' -f2)
        desc=$(echo "$result" | cut -d'|' -f3)
    else
        result=$(zenity --forms --title="New Forensic Case" --width=500 \
            --add-entry="Case Number" \
            --add-entry="Examiner" \
            --add-entry="Description" 2>/dev/null) || return
        local case_num examiner desc
        case_num=$(echo "$result" | cut -d'|' -f1)
        examiner=$(echo "$result" | cut -d'|' -f2)
        desc=$(echo "$result" | cut -d'|' -f3)
    fi

    local args=()
    [[ -n "$case_num" ]] && args+=(-n "$case_num")
    [[ -n "$examiner" ]] && args+=(-e "$examiner")
    [[ -n "$desc" ]] && args+=(-d "$desc")

    local output
    output=$("${TOOLS_DIR}/forensic-case" init "${args[@]}" 2>&1) || true
    show_info "New Case Created" "$output"
}

action_acquire_image() {
    local source dest
    if [[ "$GUI_CMD" == "yad" ]]; then
        local result
        result=$(yad --form --title="Acquire Disk Image" --width=500 \
            --field="Source Device:" "/dev/sdb" \
            --field="Destination:FL" "" \
            --field="Format:CB" "raw!ewf" \
            --button="Acquire:0" --button="Cancel:1" 2>/dev/null) || return
        source=$(echo "$result" | cut -d'|' -f1)
        dest=$(echo "$result" | cut -d'|' -f2)
    else
        source=$(zenity --entry --title="Source Device" --text="Enter source device (e.g., /dev/sdb):" 2>/dev/null) || return
        dest=$(save_chooser "Save Image As") || return
    fi

    [[ -z "$source" || -z "$dest" ]] && { show_error "Source and destination are required."; return; }

    (
        echo "10"; echo "# Starting acquisition..."
        sudo dd if="$source" of="$dest" bs=4M status=none conv=noerror,sync 2>/dev/null &
        local dd_pid=$!
        local pct=10
        while kill -0 "$dd_pid" 2>/dev/null; do
            pct=$((pct + 1))
            [[ $pct -ge 95 ]] && pct=95
            echo "$pct"
            sleep 2
        done
        wait "$dd_pid" 2>/dev/null || true
        echo "98"; echo "# Computing SHA-256 hash..."
        sha256sum "$dest" > "${dest}.sha256" 2>/dev/null || true
        echo "100"
    ) | progress_pipe "Acquiring Disk Image"

    show_message "Acquisition Complete" "Image saved to:\n$dest\nHash saved to: ${dest}.sha256"
}

action_mount_evidence() {
    local img_path mount_point
    img_path=$(file_chooser "Select Evidence Image") || return
    mount_point=$(dir_chooser "Select Mount Point") || return

    [[ -z "$img_path" ]] && { show_error "No image selected."; return; }

    local output
    output=$(sudo mount -o ro,loop,noexec,nosuid,nodev "$img_path" "$mount_point" 2>&1) && \
        show_message "Mount Successful" "Mounted read-only:\n$img_path\nat $mount_point" || \
        show_error "Mount failed:\n$output"
}

action_hash_verify() {
    local filepath
    filepath=$(file_chooser "Select File to Hash") || return
    [[ -z "$filepath" ]] && return

    local hash_result
    (
        echo "20"; echo "# Computing MD5..."
        echo "50"; echo "# Computing SHA-256..."
        echo "90"
    ) | progress_pipe "Computing Hashes"

    local md5 sha1 sha256
    md5=$(md5sum "$filepath" 2>/dev/null | awk '{print $1}')
    sha1=$(sha1sum "$filepath" 2>/dev/null | awk '{print $1}')
    sha256=$(sha256sum "$filepath" 2>/dev/null | awk '{print $1}')

    local text="File: ${filepath}\n\nMD5:    ${md5}\nSHA-1:  ${sha1}\nSHA-256: ${sha256}"
    show_info "Hash Verification Results" "$(echo -e "$text")"
}

action_file_carving() {
    local source output_dir
    source=$(file_chooser "Select Source Image") || return
    output_dir=$(dir_chooser "Select Output Directory") || return

    [[ -z "$source" || -z "$output_dir" ]] && { show_error "Source and output directory required."; return; }

    local result
    (
        echo "10"; echo "# Starting file carving..."
        if command -v foremost &>/dev/null; then
            foremost -i "$source" -o "${output_dir}/carved" 2>/dev/null
        elif command -v scalpel &>/dev/null; then
            scalpel "$source" -o "${output_dir}/carved" 2>/dev/null
        fi
        echo "100"
    ) | progress_pipe "File Carving"

    show_message "Carving Complete" "Results saved to:\n${output_dir}/carved"
}

action_timeline() {
    local source
    source=$(file_chooser "Select Image or Mount Point") || return
    [[ -z "$source" ]] && return

    local output
    output=$(save_chooser "Save Timeline As") || return

    (
        echo "10"; echo "# Generating timeline..."
        if command -v fls &>/dev/null; then
            fls -r -m "/" "$source" > /tmp/forensic_body_$$.txt 2>/dev/null || true
            if command -v mactime &>/dev/null; then
                mactime -b /tmp/forensic_body_$$.txt -d > "$output" 2>/dev/null || true
            fi
        fi
        echo "100"
    ) | progress_pipe "Timeline Analysis"

    if [[ -f "$output" ]]; then
        show_info "Timeline Results" "$(head -100 "$output" 2>/dev/null)"
    else
        show_error "Timeline generation failed. Check that sleuthkit is installed."
    fi
}

action_memory_forensics() {
    local mem_file
    mem_file=$(file_chooser "Select Memory Dump") || return
    [[ -z "$mem_file" ]] && return

    local output=""
    if command -v vol.py &>/dev/null; then
        output=$(vol.py -f "$mem_file" pslist 2>&1 || true)
    elif command -v volatility3 &>/dev/null; then
        output=$(volatility3 -f "$mem_file" windows.pslist 2>&1 || true)
    else
        show_error "Volatility not found. Install volatility3."
        return
    fi

    show_info "Memory Analysis - Process List" "$output"
}

action_network_forensics() {
    local pcap_file
    pcap_file=$(file_chooser "Select PCAP File" "*.pcap *.pcapng") || return
    [[ -z "$pcap_file" ]] && return

    if ! command -v tshark &>/dev/null; then
        show_error "tshark not found. Install wireshark-cli."
        return
    fi

    local output=""
    output+="=== Protocol Hierarchy ===\n"
    output+=$(tshark -r "$pcap_file" -q -z io,phs 2>/dev/null || echo "N/A")
    output+="\n\n=== Top Conversations ===\n"
    output+=$(tshark -r "$pcap_file" -q -z conv,tcp 2>/dev/null | head -20 || echo "N/A")
    output+="\n\n=== DNS Queries ===\n"
    output+=$(tshark -r "$pcap_file" -Y "dns.qr==0" -T fields -e dns.qry.name 2>/dev/null | sort -u | head -20 || echo "N/A")

    show_info "Network Analysis" "$(echo -e "$output")"
}

action_log_analysis() {
    local log_source
    log_source=$(file_chooser "Select Log File") || return
    [[ -z "$log_source" ]] && return

    local pattern=""
    if [[ "$GUI_CMD" == "yad" ]]; then
        pattern=$(yad --entry --title="Log Analysis" --text="Search pattern (regex, leave blank for all):" --width=400 2>/dev/null) || true
    else
        pattern=$(zenity --entry --title="Log Analysis" --text="Search pattern (regex, leave blank for all):" --width=400 2>/dev/null) || true
    fi

    local output
    if [[ -n "$pattern" ]]; then
        output=$(grep -n --color=never "$pattern" "$log_source" 2>/dev/null | head -200 || echo "No matches found.")
    else
        output=$(tail -200 "$log_source" 2>/dev/null || echo "Could not read file.")
    fi

    show_info "Log Analysis - $(basename "$log_source")" "$output"
}

action_generate_report() {
    local format="html"
    if [[ "$GUI_CMD" == "yad" ]]; then
        format=$(yad --form --title="Generate Report" --width=400 \
            --field="Format:CB" "html!pdf" \
            --button="Generate:0" --button="Cancel:1" 2>/dev/null | cut -d'|' -f1) || return
    else
        format=$(zenity --list --title="Report Format" --column="Format" "html" "pdf" --width=300 --height=200 2>/dev/null) || return
    fi

    [[ -z "$format" ]] && format="html"

    local output
    output=$("${TOOLS_DIR}/forensic-report" generate -f "$format" 2>&1) || true
    show_info "Report Generation" "$output"
}

action_case_status() {
    local output=""
    output+=$("${TOOLS_DIR}/forensic-case" status 2>&1 || echo "No active case.")
    output+="\n"
    output+=$("${TOOLS_DIR}/forensic-report" summary 2>&1 || true)
    show_info "Case Status" "$(echo -e "$output")"
}

# ─── Main Window ─────────────────────────────────────────────────────────────

main_window() {
    if [[ "$GUI_CMD" == "yad" ]]; then
        while true; do
            local choice
            choice=$(yad --title="$GUI_TITLE" \
                --width=600 --height=520 \
                --text="<b><big>ForensicOS Digital Forensic Suite</big></b>\n\nSelect an operation:" \
                --form \
                --columns=2 \
                --field="  New Case  !document-new!Create a new forensic case:FBTN" "" \
                --field="  Acquire Image  !drive-harddisk!Acquire forensic disk image:FBTN" "" \
                --field="  Mount Evidence  !media-mount!Mount evidence read-only:FBTN" "" \
                --field="  Hash Verification  !dialog-password!Compute and verify hashes:FBTN" "" \
                --field="  File Carving  !edit-find!Recover deleted files:FBTN" "" \
                --field="  Timeline Analysis  !appointment!Generate filesystem timeline:FBTN" "" \
                --field="  Memory Forensics  !memory!Analyze memory dumps:FBTN" "" \
                --field="  Network Forensics  !network-wired!Analyze PCAP files:FBTN" "" \
                --field="  Log Analysis  !text-x-log!Search and analyze logs:FBTN" "" \
                --field="  Generate Report  !document-print!Generate forensic report:FBTN" "" \
                --field="  Case Status  !dialog-information!View current case status:FBTN" "" \
                --button="Exit:1" \
                2>/dev/null) || break

            # YAD FBTN fields return the button number that was clicked
            case "$choice" in
                *1*) action_new_case ;;
                *2*) action_acquire_image ;;
                *3*) action_mount_evidence ;;
                *4*) action_hash_verify ;;
                *5*) action_file_carving ;;
                *6*) action_timeline ;;
                *7*) action_memory_forensics ;;
                *8*) action_network_forensics ;;
                *9*) action_log_analysis ;;
                *10*) action_generate_report ;;
                *11*) action_case_status ;;
            esac
        done
    else
        # Zenity fallback - list-based menu
        while true; do
            local choice
            choice=$(zenity --list \
                --title="$GUI_TITLE" \
                --width=500 --height=520 \
                --text="ForensicOS Digital Forensic Suite\n\nSelect an operation:" \
                --column="#" --column="Operation" --column="Description" \
                "1"  "New Case"          "Create a new forensic case" \
                "2"  "Acquire Image"     "Acquire forensic disk image" \
                "3"  "Mount Evidence"    "Mount evidence read-only" \
                "4"  "Hash Verification" "Compute and verify hashes" \
                "5"  "File Carving"      "Recover deleted files" \
                "6"  "Timeline Analysis" "Generate filesystem timeline" \
                "7"  "Memory Forensics"  "Analyze memory dumps" \
                "8"  "Network Forensics" "Analyze PCAP files" \
                "9"  "Log Analysis"      "Search and analyze logs" \
                "10" "Generate Report"   "Generate forensic report" \
                "11" "Case Status"       "View current case status" \
                2>/dev/null) || break

            case "$choice" in
                1|"New Case")           action_new_case ;;
                2|"Acquire Image")      action_acquire_image ;;
                3|"Mount Evidence")     action_mount_evidence ;;
                4|"Hash Verification")  action_hash_verify ;;
                5|"File Carving")       action_file_carving ;;
                6|"Timeline Analysis")  action_timeline ;;
                7|"Memory Forensics")   action_memory_forensics ;;
                8|"Network Forensics")  action_network_forensics ;;
                9|"Log Analysis")       action_log_analysis ;;
                10|"Generate Report")   action_generate_report ;;
                11|"Case Status")       action_case_status ;;
            esac
        done
    fi
}

main_window
